{
  "name": "care-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.js",
    "start:staging": "ng serve --configuration staging",
    "build": "ng build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/care-fe/browser/index.html','dist/care-fe/browser/404.html')\"",
    "build:staging": "ng build --configuration staging",
    "postbuild:staging": "node -e \"require('fs').copyFileSync('dist/care-fe-staging/browser/index.html','dist/care-fe-staging/browser/404.html')\"",
    "deploy:staging": "npm run build:staging && npx wrangler deploy --env staging && npm run purge:cache",
    "purge:cache": "node scripts/purge-cloudflare-cache.mjs",
    "deploy:prod": "npm run build && npx wrangler deploy && npm run purge:cache",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.16",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.16",
    "@angular/compiler": "^20.3.16",
    "@angular/core": "^20.3.16",
    "@angular/forms": "^20.3.16",
    "@angular/material": "^20.2.14",
    "@angular/material-moment-adapter": "^20.2.14",
    "@angular/platform-browser": "^20.3.16",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@angular/router": "^20.3.16",
    "@daily-co/daily-js": "^0.92.2",
    "@maskito/angular": "^3.2.1",
    "@maskito/core": "^3.2.1",
    "@maskito/kit": "^3.2.1",
    "moment": "^2.30.1",
    "ngx-owl-carousel-o": "^20.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.17",
    "@angular/cli": "^20.3.17",
    "@angular/compiler-cli": "^20.3.16",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "supabase": "^2.110.0",
    "typescript": "~5.9.3",
    "webpack-bundle-analyzer": "^5.3.0"
  }
}
